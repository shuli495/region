MINE_MYSQL_HOST=127.0.0.1
MINE_MYSQL_PORT=3306
MINE_MYSQL_DATABASE=region
MINE_MYSQL_USER=region_app
MINE_MYSQL_PASSWORD=replace-with-a-strong-password

# Annual MCA sync: Jan 10, 02:00 Asia/Shanghai; hourly retry and startup recovery.
REGION_VERSION_CHECK_ENABLED=true

# Required for GET /version (progress) and POST /version (resume).
REGION_ADMIN_TOKEN=

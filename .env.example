MINE_MYSQL_HOST=127.0.0.1
MINE_MYSQL_PORT=3306
MINE_MYSQL_DATABASE=region
MINE_MYSQL_USER=region_app
MINE_MYSQL_PASSWORD=replace-with-a-strong-password

# Annual MCA sync: Jan 10, 02:00 Asia/Shanghai; hourly retry and startup recovery.
REGION_VERSION_CHECK_ENABLED=true

# Optional admin token, no length or format restrictions.
# Empty: generate a random token on startup and print it to the console.
REGION_ADMIN_TOKEN=

# Next.js: copy this file to .env.local, then npm run dev (port 3099).
# Keep the application running for scheduled sync; set false to disable it.

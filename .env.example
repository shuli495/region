MINE_MYSQL_HOST=127.0.0.1
MINE_MYSQL_PORT=3306
MINE_MYSQL_DATABASE=region
MINE_MYSQL_USER=region_app
MINE_MYSQL_PASSWORD=replace-with-a-strong-password

# Disabled by default. Enabling this may pull code and execute database updates.
REGION_VERSION_CHECK_ENABLED=false
REGION_VERSION_AUTO_UPDATE=false

# Required to call POST /version. Leave empty to disable the endpoint.
REGION_ADMIN_TOKEN=
